# Copie este arquivo para .env e preencha os valores.
# O .env NÃO deve ser versionado.

# Aplicação
APP_NAME=projeto-desenvolvimento-webmobile
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
